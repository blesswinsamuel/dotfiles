<?xml version="1.0" encoding="UTF-8"?>
<!--
  Guacamole static authentication: one user, connections defined inline.

  The password below is a SHA-256 digest. The encoding attribute takes the
  lowercase keyword; "md5", "plain" and "sha256" are the accepted values.
  The Java enum names (MD5, PLAIN_TEXT, SHA_256) are NOT valid here and are
  rejected with "Invalid encoding".
  To change the password:
      printf '%s' 'new-password' | sha256sum
  then replace the authorize element's password attribute and rebuild.

  hostname/port refer to the X server on this machine, reached from guacd over
  loopback. Only the tailnet can reach the web UI, so the VNC layer does not
  need its own password.
-->
<user-mapping>
  <authorize username="blesswinsamuel" password="23a7b63446589ba00aae7e008a5824dd750c8426df03181ddf8d9127041a3e7b" encoding="sha256">
    <connection name="XFCE desktop (local VNC)">
      <protocol>vnc</protocol>
      <param name="hostname">127.0.0.1</param>
      <param name="port">5900</param>
      <param name="password">xdnjq2Ck</param>
      <param name="enable-sftp">true</param>
      <param name="sftp-root">/home/blesswinsamuel</param>
    </connection>
  </authorize>
</user-mapping>
